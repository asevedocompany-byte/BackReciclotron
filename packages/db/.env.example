# Runtime da API e apps server-side:
# use aqui a URL do Supabase Session Pooler.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@[host]:6543/postgres?pgbouncer=true&connection_limit=1"

# Migrations, introspection e comandos que precisam de conexao direta:
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"
