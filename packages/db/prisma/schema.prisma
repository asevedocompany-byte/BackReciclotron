generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminRole {
  super_admin
  operator
  analyst
}

enum EndUserStatus {
  active
  inactive
}

enum CampaignChannel {
  email
  sms
}

enum CampaignStatus {
  draft
  scheduled
  sent
}

enum LedgerEntryType {
  credit
  debit
}

enum AutomationTrigger {
  user_inactive
  high_points_balance
  manual_event
}

model AdminUser {
  id          String    @id @db.Uuid
  email       String    @unique
  name        String
  role        AdminRole
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("admin_users")
}

model EndUser {
  id            String            @id @default(uuid()) @db.Uuid
  email         String            @unique
  name          String
  city          String
  status        EndUserStatus
  pointsBalance Int               @default(0)
  phone         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  ledgerEntries PointsLedgerEntry[]

  @@index([city])
  @@index([status])
  @@map("end_users")
}

model CollectionPoint {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  city        String
  description String
  address     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([city])
  @@index([active])
  @@map("collection_points")
}

model PartnerStore {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String
  city               String
  description        String
  partnershipDetails String?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([city])
  @@index([active])
  @@map("partner_stores")
}

model AudienceSegment {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  description     String
  city            String?
  status          EndUserStatus?
  minimumPoints   Int?
  maximumPoints   Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  campaigns       Campaign[]
  automationRules AutomationRule[]

  @@index([city])
  @@index([status])
  @@map("audience_segments")
}

model Campaign {
  id                String              @id @default(uuid()) @db.Uuid
  name              String
  channel           CampaignChannel
  status            CampaignStatus      @default(draft)
  subject           String?
  message           String
  attachments       String[]            @default([])
  estimatedCost     Decimal             @default(0) @db.Decimal(10, 2)
  providerMessageId String?
  sentAt            DateTime?
  segmentId         String?             @db.Uuid
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  segment           AudienceSegment?    @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  recipients        CampaignRecipient[]

  @@index([channel, status])
  @@index([segmentId])
  @@map("campaigns")
}

model CampaignRecipient {
  id          String   @id @default(uuid()) @db.Uuid
  campaignId  String   @db.Uuid
  legacyId    Int
  email       String
  phone       String?
  recipientName String?
  status      String
  messageId   String?
  errorReason String?
  sentAt      DateTime @default(now())
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([legacyId])
  @@map("campaign_recipients")
}

model PointsLedgerEntry {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @db.Uuid
  type        LedgerEntryType
  points      Int
  description String
  source      String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        EndUser         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([type])
  @@map("points_ledger_entries")
}

model AutomationRule {
  id         String            @id @default(uuid()) @db.Uuid
  name       String
  trigger    AutomationTrigger
  channel    CampaignChannel
  template   String
  active     Boolean           @default(true)
  segmentId  String?           @db.Uuid
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  segment    AudienceSegment?  @relation(fields: [segmentId], references: [id], onDelete: SetNull)

  @@index([active, trigger])
  @@index([segmentId])
  @@map("automation_rules")
}
