{
  "name": "@reciclotron/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate --schema ./packages/db/prisma/schema.prisma && tsc -p tsconfig.json",
    "postinstall": "prisma generate --schema ./packages/db/prisma/schema.prisma",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/server.js",
    "bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "test:sms": "tsx scripts/test-sms-sns.ts"
  },
  "dependencies": {
    "@aws-sdk/client-billing": "^3.0.0",
    "@aws-sdk/client-cloudwatch": "^3.1103.0",
    "@aws-sdk/client-cost-explorer": "^3.0.0",
    "@aws-sdk/client-ses": "^3.1075.0",
    "@aws-sdk/client-sns": "^3.0.0",
    "@aws-sdk/client-sts": "^3.0.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/sensible": "^6.0.3",
    "@prisma/client": "^6.7.0",
    "@reciclotron/config": "file:./packages/config",
    "@reciclotron/contracts": "file:./packages/contracts",
    "@reciclotron/db": "file:./packages/db",
    "@reciclotron/domain": "file:./packages/domain",
    "@reciclotron/integrations": "file:./packages/integrations",
    "@supabase/supabase-js": "^2.99.0",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "mysql2": "^3.22.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
